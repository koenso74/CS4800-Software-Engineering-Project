{
  "name": "codeclimb",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/src/index.js",
    "build": "vite build",
    "test": "node --test tests/api.test.js",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.10"
  },
  "devDependencies": { "@vitejs/plugin-react": "^4.3.3", "concurrently": "^9.0.1" }
}
